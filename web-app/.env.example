# Configuración de EmailJS para la aplicación web
# Renombra este archivo a .env en el directorio web-app/ para activarlo

# Clave pública de EmailJS (ej. de formato: user_xxxx o similar en tu panel)
EMAILJS_PUBLIC_KEY=user_abcdefg1234567890

# ID del servicio de correo configurado en EmailJS (ej. service_gmail, service_outlook, etc.)
EMAILJS_SERVICE_ID=service_gmail

# ID de la plantilla de correo creada en EmailJS (ej. template_xxxxx)
EMAILJS_TEMPLATE_ID=template_rcp_recovery

# Configuración de API REST para Base de Datos en la nube (Opcional)
# Si se deja vacío, la SPA usará automáticamente LocalStorage como fallback local.
# Ejemplo de endpoint: https://api.tuempresa.com/v1 o http://localhost:3000/api
DATABASE_API_URL=https://api.tuempresa.com/v1

# Token de autorización Bearer para asegurar las peticiones hacia la base de datos externa
DATABASE_API_KEY=rcp_api_token_secure_123456789
