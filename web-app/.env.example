# Configuración de EmailJS para la aplicación web
# Renombra este archivo a .env en el directorio web-app/ para activarlo

EMAILJS_PUBLIC_KEY=tu_public_key_aqui
EMAILJS_SERVICE_ID=tu_service_id_aqui
EMAILJS_TEMPLATE_ID=tu_template_id_aqui

# Configuración de Base de Datos para la aplicación web (Local o Nube)
# Si se deja vacío, la aplicación guardará todos los datos en el LocalStorage del navegador
DATABASE_API_URL=
DATABASE_API_KEY=
