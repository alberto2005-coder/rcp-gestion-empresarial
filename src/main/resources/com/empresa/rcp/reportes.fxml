<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.*?>

<VBox spacing="20" style="-fx-padding: 28; -fx-background-color: transparent;"
      xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.empresa.rcp.module.reportes.ReportesController">

    <!-- HEADER -->
    <HBox alignment="CENTER_LEFT" spacing="12">
        <Label text="Reportes" styleClass="page-title"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button text="📄  CSV" styleClass="btn-secondary" onAction="#exportarCSV"/>
        <Button text="📋  PDF" styleClass="btn-secondary" onAction="#exportarPDF"/>
    </HBox>

    <!-- FILTERS -->
    <HBox styleClass="card" spacing="20" alignment="CENTER_LEFT">
        <Label text="Tipo:" style="-fx-text-fill: #94a3b8;"/>
        <ComboBox fx:id="cbTipo" prefWidth="180"/>
        <Separator orientation="VERTICAL"/>
        <Label text="Desde:" style="-fx-text-fill: #94a3b8;"/>
        <DatePicker fx:id="dpDesde" prefWidth="160"/>
        <Label text="Hasta:" style="-fx-text-fill: #94a3b8;"/>
        <DatePicker fx:id="dpHasta" prefWidth="160"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button text="▶  Generar" styleClass="btn-primary" onAction="#generarReporte"/>
    </HBox>

    <!-- KPI MINI ROW -->
    <HBox spacing="12">
        <VBox styleClass="kpi-card" HBox.hgrow="ALWAYS" spacing="4">
            <Label text="TOTAL" styleClass="kpi-title"/>
            <Label fx:id="lblTotal" text="—" styleClass="kpi-value-sm"/>
        </VBox>
        <VBox styleClass="kpi-card" HBox.hgrow="ALWAYS" spacing="4">
            <Label text="PROMEDIO MENSUAL" styleClass="kpi-title"/>
            <Label fx:id="lblPromedio" text="—" styleClass="kpi-value-sm"/>
        </VBox>
        <VBox styleClass="kpi-card" HBox.hgrow="ALWAYS" spacing="4">
            <Label text="MÁXIMO" styleClass="kpi-title"/>
            <Label fx:id="lblMaximo" text="—" styleClass="kpi-value-sm"/>
        </VBox>
    </HBox>

    <!-- AREA/LINE CHART -->
    <VBox styleClass="card" spacing="8">
        <Label text="Evolución en el período" styleClass="card-title"/>
        <Pane fx:id="paneAreaChart" prefHeight="240"/>
    </VBox>

    <!-- BAR COMPARATIVE -->
    <VBox styleClass="card" spacing="8">
        <Label text="Distribución mensual" styleClass="card-title"/>
        <Pane fx:id="paneBarChart" prefHeight="220"/>
    </VBox>

    <Label fx:id="lblResultado" text="" style="-fx-text-fill: #64748b; -fx-font-size: 11;"/>
</VBox>
