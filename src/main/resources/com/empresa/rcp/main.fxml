<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.*?>

<BorderPane fx:id="mainPane" stylesheets="@../css/styles.css" xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.empresa.rcp.MainController"
            styleClass="root-pane">

    <top>
        <HBox styleClass="topbar" alignment="CENTER_LEFT" spacing="0">
            <HBox alignment="CENTER_LEFT" spacing="10" minWidth="220" maxWidth="220"
                  style="-fx-background-color: #0d1b2a; -fx-padding: 0 16;">
                <Label text="◈" style="-fx-text-fill: #3b82f6; -fx-font-size: 22;"/>
                <Label text="RCP Corp" style="-fx-text-fill: #f8fafc; -fx-font-size: 15; -fx-font-weight: bold;"/>
            </HBox>
            <Separator orientation="VERTICAL"/>
            <Label text="Panel de Control Empresarial"
                   style="-fx-text-fill: #94a3b8; -fx-font-size: 13; -fx-padding: 0 20;"/>
            <Region HBox.hgrow="ALWAYS"/>
            <HBox alignment="CENTER" spacing="12" style="-fx-padding: 0 24;">
                <Label text="🔔" style="-fx-font-size: 16; -fx-cursor: hand;"/>
                <Separator orientation="VERTICAL"/>
                <Label text="👤" style="-fx-font-size: 16;"/>
                <VBox alignment="CENTER_LEFT" spacing="1">
                    <Label text="Administrador" style="-fx-text-fill: #f1f5f9; -fx-font-size: 13; -fx-font-weight: bold;"/>
                    <Label text="admin@empresa.es" style="-fx-text-fill: #64748b; -fx-font-size: 11;"/>
                </VBox>
            </HBox>
        </HBox>
    </top>

    <center>
        <HBox>
            <VBox styleClass="sidebar" minWidth="220" maxWidth="220" spacing="2">
                <VBox.margin><Insets top="16" bottom="16" left="8" right="8"/></VBox.margin>

                <Label text="NAVEGACIÓN" styleClass="sidebar-section-label"/>

                <ToggleButton fx:id="btnDashboard" text="  📊   Dashboard"
                              styleClass="nav-btn" selected="true"
                              onAction="#onDashboard" maxWidth="Infinity"/>

                <ToggleButton fx:id="btnClientes" text="  👥   Clientes"
                              styleClass="nav-btn"
                              onAction="#onClientes" maxWidth="Infinity"/>

                <ToggleButton fx:id="btnProductos" text="  📦   Productos"
                              styleClass="nav-btn"
                              onAction="#onProductos" maxWidth="Infinity"/>

                <ToggleButton fx:id="btnVentas" text="  💰   Ventas"
                              styleClass="nav-btn"
                              onAction="#onVentas" maxWidth="Infinity"/>

                <ToggleButton fx:id="btnReportes" text="  📈   Reportes"
                              styleClass="nav-btn"
                              onAction="#onReportes" maxWidth="Infinity"/>

                <Region VBox.vgrow="ALWAYS"/>
                <Separator style="-fx-background-color: #1e3a5f;"/>
                <VBox.margin><Insets bottom="8"/></VBox.margin>

                <Label text="SISTEMA" styleClass="sidebar-section-label"/>
                <ToggleButton fx:id="btnConfig" text="  ⚙️   Configuración"
                              styleClass="nav-btn"
                              onAction="#onConfig" maxWidth="Infinity"/>
            </VBox>

            <StackPane fx:id="contentArea" HBox.hgrow="ALWAYS" styleClass="content-area"/>
        </HBox>
    </center>
</BorderPane>