<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" spacing="20" stylesheets="@../css/styles.css" xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml" fx:controller="com.empresa.rcp.module.auth.AuthController"
      style="-fx-background-color: var(--bg-main); -fx-min-width: 450; -fx-min-height: 600;">
    
    <VBox spacing="20" styleClass="card" maxWidth="420" alignment="CENTER">
        <padding>
            <Insets top="25" right="25" bottom="25" left="25"/>
        </padding>

        <VBox alignment="CENTER" spacing="5">
            <Label text="📝 Registro de Usuario" style="-fx-font-size: 20; -fx-font-weight: 800; -fx-text-fill: var(--accent-color);"/>
            <Label text="Crea una cuenta para acceder al sistema" styleClass="kpi-title"/>
        </VBox>

        <VBox spacing="12" alignment="CENTER_LEFT">
            <VBox spacing="4">
                <Label text="Usuario" styleClass="card-title"/>
                <TextField fx:id="txtRegUsuario" promptText="admin o empleado" maxWidth="Infinity"/>
            </VBox>

            <VBox spacing="4">
                <Label text="Email" styleClass="card-title"/>
                <TextField fx:id="txtRegEmail" promptText="usuario@empresa.com" maxWidth="Infinity"/>
            </VBox>

            <VBox spacing="4">
                <Label text="Rol" styleClass="card-title"/>
                <ComboBox fx:id="cmbRegRol" maxWidth="Infinity"/>
            </VBox>

            <VBox spacing="4">
                <Label text="Contraseña" styleClass="card-title"/>
                <PasswordField fx:id="txtRegPassword" promptText="Mínimo 6 caracteres" maxWidth="Infinity"/>
            </VBox>
        </VBox>
 
        <Label fx:id="lblRegError" styleClass="error" wrapText="true" textAlignment="CENTER"/>
        <Label fx:id="lblRegSuccess" styleClass="success" wrapText="true" textAlignment="CENTER"/>

        <VBox spacing="10" alignment="CENTER" maxWidth="Infinity">
            <Button text="💾 Crear Cuenta" onAction="#onRegistrar" maxWidth="Infinity" style="-fx-font-size: 13; -fx-padding: 10 20;"/>
            <Button text="◀ Volver al Login" onAction="#onIrALogin" styleClass="btn-secondary" maxWidth="Infinity"/>
        </VBox>
    </VBox>
</VBox>
