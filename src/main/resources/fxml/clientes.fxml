<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="15" style="-fx-padding: 20;"
      xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.empresa.rcp.module.clientes.ClientesController">

    <Label text="Gestión de Clientes" style="-fx-font-size: 24; -fx-font-weight: bold;"/>

    <!-- Búsqueda -->
    <HBox spacing="10" alignment="CENTER_LEFT">
        <TextField fx:id="txtBuscar" promptText="Buscar cliente..." style="-fx-padding: 8; -fx-font-size: 12;"
                   HBox.hgrow="ALWAYS"/>
        <Label fx:id="lblTotal" text="0 clientes" style="-fx-font-size: 12; -fx-font-weight: bold;"/>
    </HBox>

    <!-- Tabla -->
    <TableView fx:id="tablaClientes" style="-fx-font-size: 12;" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colId" text="ID" prefWidth="50"/>
            <TableColumn fx:id="colNombre" text="Nombre" prefWidth="150"/>
            <TableColumn fx:id="colEmail" text="Email" prefWidth="200"/>
            <TableColumn fx:id="colTelefono" text="Teléfono" prefWidth="120"/>
            <TableColumn fx:id="colCiudad" text="Ciudad" prefWidth="120"/>
            <TableColumn fx:id="colEstado" text="Estado" prefWidth="100"/>
        </columns>
    </TableView>

    <!-- Formulario -->
    <VBox spacing="10" style="-fx-border-color: #88888840; -fx-border-width: 1; -fx-padding: 15; -fx-border-radius: 5;">
        <Label text="Detalles del Cliente" style="-fx-font-size: 14; -fx-font-weight: bold;"/>
        
        <HBox spacing="10">
            <VBox spacing="5" HBox.hgrow="ALWAYS">
                <Label text="Nombre" style="-fx-font-size: 11;"/>
                <TextField fx:id="txtNombre" style="-fx-padding: 8; -fx-font-size: 11;"/>
            </VBox>
            <VBox spacing="5" HBox.hgrow="ALWAYS">
                <Label text="Email" style="-fx-font-size: 11;"/>
                <TextField fx:id="txtEmail" style="-fx-padding: 8; -fx-font-size: 11;"/>
            </VBox>
            <VBox spacing="5" HBox.hgrow="ALWAYS">
                <Label text="Teléfono" style="-fx-font-size: 11;"/>
                <TextField fx:id="txtTelefono" style="-fx-padding: 8; -fx-font-size: 11;"/>
            </VBox>
        </HBox>

        <HBox spacing="10">
            <VBox spacing="5" HBox.hgrow="ALWAYS">
                <Label text="Ciudad" style="-fx-font-size: 11;"/>
                <TextField fx:id="txtCiudad" style="-fx-padding: 8; -fx-font-size: 11;"/>
            </VBox>
            <VBox spacing="5" HBox.hgrow="ALWAYS">
                <Label text="Estado" style="-fx-font-size: 11;"/>
                <ComboBox fx:id="cmbEstado" style="-fx-padding: 8; -fx-font-size: 11;" maxWidth="Infinity"/>
            </VBox>
            <VBox spacing="5" HBox.hgrow="ALWAYS"/>
        </HBox>

        <!-- Botones -->
        <HBox spacing="10" style="-fx-alignment: CENTER_RIGHT;">
            <Button text="📂 Importar CSV" onAction="#onImportarCSV" style="-fx-padding: 8 15; -fx-font-size: 11;"/>
            <Button fx:id="btnAgregar" text="➕ Agregar" onAction="#onNuevoCliente" style="-fx-padding: 8 15; -fx-font-size: 11;"/>
            <Button fx:id="btnActualizar" text="✏️ Actualizar" onAction="#onEditarCliente" style="-fx-padding: 8 15; -fx-font-size: 11;"/>
            <Button fx:id="btnEliminar" text="🗑️ Eliminar" onAction="#onEliminarCliente" style="-fx-padding: 8 15; -fx-font-size: 11;"/>
        </HBox>
    </VBox>
</VBox>
