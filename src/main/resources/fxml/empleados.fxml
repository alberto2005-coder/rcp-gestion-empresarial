<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="15" style="-fx-padding: 20;"
      xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.empresa.rcp.module.empleados.EmpleadosController">

    <Label text="Gestión de Empleados" style="-fx-font-size: 24; -fx-font-weight: bold;"/>

    <!-- Búsqueda -->
    <HBox spacing="10">
        <TextField fx:id="txtBuscar" promptText="Buscar empleado..." style="-fx-padding: 8; -fx-font-size: 12;"
                   HBox.hgrow="ALWAYS"/>
    </HBox>

    <!-- Tabla -->
    <TableView fx:id="tableEmpleados" style="-fx-font-size: 12;" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colId" text="ID" prefWidth="50"/>
            <TableColumn fx:id="colNombre" text="Nombre" prefWidth="150"/>
            <TableColumn fx:id="colEmail" text="Email" prefWidth="200"/>
            <TableColumn fx:id="colPuesto" text="Puesto" prefWidth="150"/>
            <TableColumn fx:id="colSalario" text="Salario" prefWidth="120"/>
        </columns>
    </TableView>

    <!-- Formulario -->
    <VBox spacing="10" style="-fx-border-color: #88888840; -fx-border-width: 1; -fx-padding: 15; -fx-border-radius: 5;">
        <Label text="Detalles del Empleado" style="-fx-font-size: 14; -fx-font-weight: bold;"/>
        
        <HBox spacing="10">
            <VBox spacing="5" HBox.hgrow="ALWAYS">
                <Label text="Nombre" style="-fx-font-size: 11;"/>
                <TextField fx:id="txtNombre" style="-fx-padding: 8; -fx-font-size: 11;"/>
            </VBox>
            <VBox spacing="5" HBox.hgrow="ALWAYS">
                <Label text="Apellido" style="-fx-font-size: 11;"/>
                <TextField fx:id="txtApellido" style="-fx-padding: 8; -fx-font-size: 11;"/>
            </VBox>
            <VBox spacing="5" HBox.hgrow="ALWAYS">
                <Label text="Email" style="-fx-font-size: 11;"/>
                <TextField fx:id="txtEmail" style="-fx-padding: 8; -fx-font-size: 11;"/>
            </VBox>
        </HBox>

        <HBox spacing="10">
            <VBox spacing="5" HBox.hgrow="ALWAYS">
                <Label text="Teléfono" style="-fx-font-size: 11;"/>
                <TextField fx:id="txtTelefono" style="-fx-padding: 8; -fx-font-size: 11;"/>
            </VBox>
            <VBox spacing="5" HBox.hgrow="ALWAYS">
                <Label text="Puesto" style="-fx-font-size: 11;"/>
                <TextField fx:id="txtPuesto" style="-fx-padding: 8; -fx-font-size: 11;"/>
            </VBox>
            <VBox spacing="5" HBox.hgrow="ALWAYS">
                <Label text="Salario" style="-fx-font-size: 11;"/>
                <TextField fx:id="txtSalario" style="-fx-padding: 8; -fx-font-size: 11;"/>
            </VBox>
        </HBox>

        <!-- Botones -->
        <HBox spacing="10" style="-fx-alignment: CENTER_RIGHT;">
            <Button text="📂 Importar CSV" onAction="#onImportarCSV" style="-fx-padding: 8 15; -fx-font-size: 11;"/>
            <Button fx:id="btnAgregar" text="➕ Agregar" onAction="#onNuevoEmpleado" style="-fx-padding: 8 15; -fx-font-size: 11;"/>
            <Button fx:id="btnActualizar" text="✏️ Actualizar" onAction="#onEditarEmpleado" style="-fx-padding: 8 15; -fx-font-size: 11;"/>
            <Button fx:id="btnEliminar" text="🗑️ Eliminar" onAction="#onEliminarEmpleado" style="-fx-padding: 8 15; -fx-font-size: 11;"/>
        </HBox>
    </VBox>
</VBox>
